# serializer version: 1
# name: TestAccountUsersQuery.test_widget_query_supports_display_names_filters_search_sort_and_pages
  '''
  SELECT tuple(coalesce(nullIf(toString(persons.properties___email), %(hogql_val_18)s), nullIf(toString(persons.properties___name), %(hogql_val_19)s), nullIf(toString(persons.properties___username), %(hogql_val_20)s), toString(persons.id)), toString(persons.id)),
         persons.properties___plan AS plan,
         source.account_last_seen AS account_last_seen
  FROM
    (SELECT pdi.person_id AS person_id,
            groupUniqArray(101)(membership.distinct_id) AS distinct_ids,
            min(toTimeZone(membership.first_seen, %(hogql_val_1)s)) AS account_first_seen,
            max(toTimeZone(membership.last_seen, %(hogql_val_2)s)) AS account_last_seen
     FROM person_group_membership AS membership
     INNER JOIN
       (SELECT argMax(person_distinct_id2.person_id, person_distinct_id2.version) AS person_id,
               person_distinct_id2.distinct_id AS distinct_id
        FROM person_distinct_id2
        WHERE and(equals(person_distinct_id2.team_id, 99999), in(person_distinct_id2.distinct_id,
                                                                   (SELECT person_group_membership.distinct_id AS distinct_id
                                                                    FROM person_group_membership
                                                                    WHERE and(equals(person_group_membership.team_id, 99999), equals(person_group_membership.group_type_index, 0), equals(person_group_membership.group_key, %(hogql_val_0)s)))))
        GROUP BY person_distinct_id2.distinct_id
        HAVING equals(argMax(person_distinct_id2.is_deleted, person_distinct_id2.version), 0)) AS pdi ON equals(membership.distinct_id, pdi.distinct_id)
     WHERE and(equals(membership.team_id, 99999), equals(membership.group_type_index, 0), equals(membership.group_key, %(hogql_val_3)s))
     GROUP BY pdi.person_id) AS source
  INNER JOIN
    (SELECT tupleElement(argMax(tuple(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(person.properties, %(hogql_val_4)s), ''), 'null'), '^"|"$', '')), person.version), 1) AS properties___email,
            tupleElement(argMax(tuple(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(person.properties, %(hogql_val_5)s), ''), 'null'), '^"|"$', '')), person.version), 1) AS properties___name,
            tupleElement(argMax(tuple(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(person.properties, %(hogql_val_6)s), ''), 'null'), '^"|"$', '')), person.version), 1) AS properties___username,
            tupleElement(argMax(tuple(replaceRegexpAll(nullIf(nullIf(JSONExtractRaw(person.properties, %(hogql_val_7)s), ''), 'null'), '^"|"$', '')), person.version), 1) AS properties___plan,
            person.id AS id
     FROM person PREWHERE and(in(id,
                                   (SELECT source.person_id AS person_id
                                    FROM
                                      (SELECT pdi.person_id AS person_id, groupUniqArray(101)(membership.distinct_id) AS distinct_ids, min(toTimeZone(membership.first_seen, %(hogql_val_9)s)) AS account_first_seen, max(toTimeZone(membership.last_seen, %(hogql_val_10)s)) AS account_last_seen
                                       FROM person_group_membership AS membership
                                       INNER JOIN
                                         (SELECT argMax(person_distinct_id2.person_id, person_distinct_id2.version) AS person_id, person_distinct_id2.distinct_id AS distinct_id
                                          FROM person_distinct_id2
                                          WHERE and(equals(person_distinct_id2.team_id, 99999), in(person_distinct_id2.distinct_id,
                                                                                                     (SELECT person_group_membership.distinct_id AS distinct_id
                                                                                                      FROM person_group_membership
                                                                                                      WHERE and(equals(person_group_membership.team_id, 99999), equals(person_group_membership.group_type_index, 0), equals(person_group_membership.group_key, %(hogql_val_8)s)))))
                                          GROUP BY person_distinct_id2.distinct_id
                                          HAVING equals(argMax(person_distinct_id2.is_deleted, person_distinct_id2.version), 0)) AS pdi ON equals(membership.distinct_id, pdi.distinct_id)
                                       WHERE and(equals(membership.team_id, 99999), equals(membership.group_type_index, 0), equals(membership.group_key, %(hogql_val_11)s))
                                       GROUP BY pdi.person_id) AS source)), in(id,
                                                                                 (SELECT source.person_id AS person_id
                                                                                  FROM
                                                                                    (SELECT pdi.person_id AS person_id, groupUniqArray(101)(membership.distinct_id) AS distinct_ids, min(toTimeZone(membership.first_seen, %(hogql_val_13)s)) AS account_first_seen, max(toTimeZone(membership.last_seen, %(hogql_val_14)s)) AS account_last_seen
                                                                                     FROM person_group_membership AS membership
                                                                                     INNER JOIN
                                                                                       (SELECT argMax(person_distinct_id2.person_id, person_distinct_id2.version) AS person_id, person_distinct_id2.distinct_id AS distinct_id
                                                                                        FROM person_distinct_id2
                                                                                        WHERE and(equals(person_distinct_id2.team_id, 99999), in(person_distinct_id2.distinct_id,
                                                                                                                                                   (SELECT person_group_membership.distinct_id AS distinct_id
                                                                                                                                                    FROM person_group_membership
                                                                                                                                                    WHERE and(equals(person_group_membership.team_id, 99999), equals(person_group_membership.group_type_index, 0), equals(person_group_membership.group_key, %(hogql_val_12)s)))))
                                                                                        GROUP BY person_distinct_id2.distinct_id
                                                                                        HAVING equals(argMax(person_distinct_id2.is_deleted, person_distinct_id2.version), 0)) AS pdi ON equals(membership.distinct_id, pdi.distinct_id)
                                                                                     WHERE and(equals(membership.team_id, 99999), equals(membership.group_type_index, 0), equals(membership.group_key, %(hogql_val_15)s))
                                                                                     GROUP BY pdi.person_id) AS source)))
     WHERE equals(person.team_id, 99999)
     GROUP BY person.id
     HAVING and(equals(argMax(person.is_deleted, person.version), 0), less(argMax(toTimeZone(person.created_at, %(hogql_val_16)s), person.version), plus(now64(6, %(hogql_val_17)s), toIntervalDay(1)))) SETTINGS optimize_aggregation_in_order=1) AS persons ON equals(persons.id, source.person_id)
  ORDER BY source.account_last_seen DESC
  LIMIT 2
  OFFSET 0 SETTINGS optimize_aggregation_in_order=1,
                    join_algorithm='auto'
  '''
# ---
# name: TestMembershipSchema.test_membership_is_namespaced_and_team_guarded
  '''
  SELECT person_group_membership.distinct_id AS distinct_id
  FROM person_group_membership
  WHERE and(equals(person_group_membership.team_id, 99999), equals(person_group_membership.group_key, %(hogql_val_0)s))
  LIMIT 50000
  '''
# ---
# name: TestMembershipSchema.test_source_resolves_current_mappings_and_binds_account_key
  '''
  SELECT pdi.person_id AS person_id,
         groupUniqArray(101)(membership.distinct_id) AS distinct_ids,
         min(toTimeZone(membership.first_seen, %(hogql_val_1)s)) AS account_first_seen,
         max(toTimeZone(membership.last_seen, %(hogql_val_2)s)) AS account_last_seen
  FROM person_group_membership AS membership
  INNER JOIN
    (SELECT argMax(person_distinct_id2.person_id, person_distinct_id2.version) AS person_id,
            person_distinct_id2.distinct_id AS distinct_id
     FROM person_distinct_id2
     WHERE and(equals(person_distinct_id2.team_id, 99999), in(person_distinct_id2.distinct_id,
                                                                (SELECT person_group_membership.distinct_id AS distinct_id
                                                                 FROM person_group_membership
                                                                 WHERE and(equals(person_group_membership.team_id, 99999), equals(person_group_membership.group_type_index, 0), equals(person_group_membership.group_key, %(hogql_val_0)s)))))
     GROUP BY person_distinct_id2.distinct_id
     HAVING equals(argMax(person_distinct_id2.is_deleted, person_distinct_id2.version), 0)) AS pdi ON equals(membership.distinct_id, pdi.distinct_id)
  WHERE and(equals(membership.team_id, 99999), equals(membership.group_type_index, 0), equals(membership.group_key, %(hogql_val_3)s))
  GROUP BY pdi.person_id
  LIMIT 50000
  '''
# ---
